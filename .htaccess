Options -Indexes
DirectorySlash Off

RewriteEngine On

# Highest precedence: /signal and /signal/ both serve signal.html. Without this,
# LiteSpeed sees the signal/ directory and 301-redirects /signal → /signal/, which
# then 403s because Options -Indexes blocks directory listing. Two rules cover
# both with-slash and without-slash entry points.
RewriteRule ^signal/?$ signal.html [NC,L]

# IC workshop June 25 (2026-06-12): registration page lives at /workshop/.
# Serve the directory index explicitly (DirectorySlash Off would otherwise
# send /workshop into the clean-URL rule and 404 on workshop.html).
RewriteRule ^workshop/?$ workshop/index.html [NC,L]
# A/B variant B of the workshop page (paid/ad traffic lands here via /w/ads).
# Same directory-index pattern as /workshop so /workshop-b and /workshop-b/ both serve.
RewriteRule ^workshop-b/?$ workshop-b/index.html [NC,L]

# IC lead-magnet opt-in (free AI checklist) lives at /ai-checklist/.
# Same directory-index pattern as /workshop. Captures cold Meta-ad traffic.
RewriteRule ^ai-checklist/?$ ai-checklist/index.html [NC,L]
# IC simple one-screen QR conversion page (StartFEST + /w/ss) lives at /seat/.
RewriteRule ^seat/?$ seat/index.html [NC,L]
# The July 30 attendee take-home kit lives at /kit/. This is the QR target
# printed on the cards and shown on the closing slide, so both the with-slash
# and without-slash forms have to resolve: DirectorySlash Off would otherwise
# send /kit into the clean-URL rule and 404 on kit.html.
#
# 2026-07-30: /kit and /kit/ both resolved, but only one of them WORKED.
# Serving the no-slash form in place left the document base at /kit, so every
# relative href on the page resolved against the site root instead of the kit
# directory: "Read the deck" went to /deck.html and "The one page cheat sheet"
# to /handout.html, both 404, and the slides PDF, the skill zip and the
# service worker registration went the same way, which silently killed the
# offline support this page depends on at the venue. The 301 below sends the
# no-slash form to the canonical directory URL BEFORE the page renders, so the
# base is right and the relative links land where they were always meant to.
# It must stay ahead of the serve rule, and it cannot loop: /kit/ has a
# trailing slash and so never matches ^kit$.
RewriteRule ^kit$ /kit/ [R=301,L]
RewriteRule ^kit/?$ kit/index.html [NC,L]
# The first draft of the kit page, kept at /kit-v1/ so the difference between
# what came out first and what shipped can be put on a screen side by side. It
# is linked from nowhere and carries noindex; it is opened by URL only. Same
# 301-then-serve shape as /kit above, for the same reason: served in place, the
# no-slash form would leave the base at /kit-v1 and break the page's own links.
RewriteRule ^kit-v1$ /kit-v1/ [R=301,L]
RewriteRule ^kit-v1/?$ kit-v1/index.html [NC,L]
# Customer-facing support + privacy pages (Stripe links point here). Same
# directory-index pattern as /workshop: DirectorySlash Off would otherwise send
# /support and /privacy into the clean-URL rule and 404 on support.html.
RewriteRule ^support/?$ support/index.html [NC,L]
RewriteRule ^privacy/?$ privacy/index.html [NC,L]
RewriteRule ^terms/?$ terms/index.html [NC,L]
# SW cold-email link consistency (2026-07-15): signature shows
# catalystworks.consulting/geolisted so recipients see one CW domain.
# Send them straight through to the geolisted.co landing page.
RewriteRule ^geolisted/?$ https://geolisted.co/ [R=301,L]
# Free ($0) Stripe checkout success page (after_completion redirect target for the
# $0 free-seat payment link). Confirms the free July 30 reservation.
RewriteRule ^free-thank-you/?$ free-thank-you/index.html [NC,L]
# The July 16 free session was CANCELLED and its page only hit Beehiiv while
# advertising a dead date. Repoint any straggler still holding an old
# SBDC-newsletter link straight to the live July 30 free-seat capture, which
# actually reserves the $0 seat (email captured + prefilled into the Stripe
# reservation). Organic medium keeps ad-spend attribution honest. The old
# HTML stays on disk but is unreachable via its canonical URL.
RewriteRule ^free-workshop-july16/?$ /ai-checklist/?utm_source=sbdc&utm_medium=organic&utm_campaign=ic_workshop_0730&utm_content=stale_july16_redirect [R=301,L]
# The July 30 comp-seat RSVP page booked NOTHING (Beehiiv-only) yet told
# visitors "your seat is held" -- a false claim. Repoint to the live free-seat
# capture that actually reserves the $0 seat. Organic medium keeps attribution
# honest. NOTE: /w/vip below still resolves here via a second 301 hop.
RewriteRule ^rsvp-0730/?$ /ai-checklist/?utm_source=direct_invite&utm_medium=organic&utm_campaign=ic_workshop_0730&utm_content=stale_rsvp0730_redirect [R=301,L]
# Services offer-ladder page lives at /services/ (unlinked preview, awaiting nav sign-off).
RewriteRule ^services/?$ services/index.html [NC,L]
# 5-Day Bottleneck Audit landing page lives at /bottleneck-audit/ (unlinked preview, awaiting nav sign-off).
RewriteRule ^bottleneck-audit/?$ bottleneck-audit/index.html [NC,L]
# Short link for the lead-magnet (Meta ads + any channel): /w/start -> opt-in page.
# Campaign = stable magnet base; utm_content carries the current cohort for per-run segmentation.
RewriteRule ^w/start/?$ /ai-checklist/?utm_source=meta&utm_medium=paid&utm_campaign=ic_workshop_leadmagnet&utm_content=cohort:2026_06_25 [R=301,L,QSA]

# Workshop short links: one per channel, UTM baked behind the 301.
# Never reuse a slug across campaigns.
# 2026-07-27: the July 30 workshop stays FREE through the event (2026-07-25
# decision), so every partner slug below that still pointed at /workshop/ (the
# $47 flow) was sending a partner's audience to a paid page for a free event.
# Repointed to /ai-checklist/, the live free-seat capture, matching w/li's shape.
# Each slug keeps its own utm_source + utm_content so per-partner attribution
# survives; slugs that carried no utm_content got a meaningful one rather than
# collapsing into an unattributable blob. Same "track_free" prohibition applies:
# /workshop/ and /workshop-b/ attribute the paid split test with
# /track_free/.test(utm_content), so no value here may contain that substring.
RewriteRule ^w/svc/?$ /ai-checklist/?utm_source=chamber&utm_medium=email&utm_campaign=ic_workshop_0730&utm_content=south_valley [R=301,L,QSA]
RewriteRule ^w/sjc/?$ /ai-checklist/?utm_source=chamber&utm_medium=email&utm_campaign=ic_workshop_0730&utm_content=south_jordan [R=301,L,QSA]
# 2026-07-21 (Boubacar, explicit): the organic LinkedIn + X push for July 30 goes
# to the FREE seat capture, not the $47 page. Both were pointed at /workshop/,
# which is the paid flow. Repointed to /ai-checklist/, the live free-seat page.
# utm_medium=organic because these are hand-posted, not an ad buy (same reason
# w/fb-organic exists). utm_content MUST NOT contain "track_free" -- /workshop/
# and /workshop-b/ attribute the paid split test with /track_free/.test(utm_content),
# so "organic_li" / "organic_x" keep organic clicks out of the paid free-first arm.
RewriteRule ^w/li/?$ /ai-checklist/?utm_source=linkedin&utm_medium=organic&utm_campaign=ic_workshop_0730&utm_content=organic_li [R=301,L,QSA]
RewriteRule ^w/x/?$ /ai-checklist/?utm_source=x&utm_medium=organic&utm_campaign=ic_workshop_0730&utm_content=organic_x [R=301,L,QSA]
RewriteRule ^w/nl/?$ /ai-checklist/?utm_source=newsletter&utm_medium=email&utm_campaign=ic_workshop_0730&utm_content=newsletter [R=301,L,QSA]
# SPLIT TEST (July 30 workshop) -- two paid Meta tracks under one campaign,
# distinguished by utm_content so seats are attributable per track.
# Track 1 DIRECT: was cold ad -> $47 seat page (variant B). 2026-07-27: repointed
# to the free capture with the rest (see RESTORE NOTE at the bottom of this file).
# The ad set is paused at $0/day, so the split test is not actively running and
# nothing is being corrupted mid-flight. utm_content=track_direct is preserved so
# the track stays distinguishable when the paid destination is restored.
RewriteRule ^w/ads/?$ /ai-checklist/?utm_source=meta&utm_medium=paid&utm_campaign=ic_workshop_0730&utm_content=track_direct [R=301,L,QSA]
# Track 2 FREE-FIRST: cold ad -> free AI checklist (email capture + Meta Lead)
# then its built-in CTA to the $47 July 30 seat. utm_content=track_free.
RewriteRule ^w/free/?$ /ai-checklist/?utm_source=meta&utm_medium=paid&utm_campaign=ic_workshop_0730&utm_content=track_free [R=301,L,QSA]
RewriteRule ^w/fb/?$ /ai-checklist/?utm_source=facebook&utm_medium=paid&utm_campaign=ic_workshop_leadmagnet&utm_content=fb_ad [R=301,L,QSA]

# ORGANIC free-seat link -- for a hand-posted FB/social post, NOT an ad buy.
# Exists because every /w/ free-seat slug above bakes utm_medium=paid: sharing
# one in an organic post logs the click as paid Meta traffic and corrupts the
# ad-spend read. This is the attribution-honest slug for anything Boubacar
# posts by hand.
# utm_content MUST NOT contain the substring "track_free": /workshop/ and
# /workshop-b/ attribute the split test with /track_free/.test(utm_content),
# so a value like "track_free_organic" would silently register organic clicks
# as the paid free-first arm. "organic_fb" cannot match, which is the point.
RewriteRule ^w/fb-organic/?$ /ai-checklist/?utm_source=facebook&utm_medium=organic&utm_campaign=ic_workshop_0730&utm_content=organic_fb [R=301,L,QSA]

# Paid-seat counterpart to /w/free. Direct/hand-shared attribution, no channel
# baked in. 2026-07-27: repointed to the free capture with the rest. This slug is
# hand-shareable, so while the July 30 workshop is free it was the likeliest way
# for someone to hit a $47 checkout for a free event. utm_content=direct_paid is
# preserved unchanged so restoring is a destination swap, nothing else.
RewriteRule ^w/paid/?$ /ai-checklist/?utm_source=direct&utm_medium=link&utm_campaign=ic_workshop_0730&utm_content=direct_paid [R=301,L,QSA]

# Same 2026-07-27 free-event repoint as the chamber slugs above. w/ss pointed at
# /seat/, which renders a $47 "Reserve my seat" CTA wired to the paid Stripe
# link, so it was a paid destination too despite not being /workshop/.
RewriteRule ^w/sbdc/?$ /ai-checklist/?utm_source=sbdc&utm_medium=partner&utm_campaign=ic_workshop_0730&utm_content=sbdc_partner [R=301,L,QSA]
RewriteRule ^w/beccy/?$ /ai-checklist/?utm_source=beccy&utm_medium=email&utm_campaign=ic_workshop_0730&utm_content=beccy [R=301,L,QSA]
RewriteRule ^w/ss/?$ /ai-checklist/?utm_source=silicon_slopes&utm_medium=event&utm_campaign=ic_workshop_0730&utm_content=silicon_slopes [R=301,L,QSA]

# Old SBDC-newsletter short link for the CANCELLED July 16 free session. Its old
# target (/free-workshop-july16/) now 301s to the live July 30 free-seat capture;
# point this straight there too so a straggler clicking the old newsletter link
# lands on the working capture in a single hop, not a double 301.
RewriteRule ^w/july16/?$ /ai-checklist/?utm_source=sbdc&utm_medium=organic&utm_campaign=ic_workshop_0730&utm_content=stale_july16_shortlink [R=301,L]

# DISCRETE comp-seat link for July 30 -- Boubacar shares this 1:1 only (never
# posted publicly, never linked from the paid page). Confirms a free seat with
# NO Stripe charge.
# 2026-07-27: was /rsvp-0730/, which itself 301s to /ai-checklist/. That second
# hop carries its own query string and no QSA, so the comp UTMs were silently
# discarded and overwritten with stale_rsvp0730_redirect -- comp seats were not
# separable from organic in the data. Collapsed to a single hop straight to the
# same final page, which strictly preserves MORE attribution than before rather
# than trading any away. Same single-hop treatment w/july16 already got.
# "track_comp" cannot match /track_free/, so it stays out of the paid free-first arm.
RewriteRule ^w/vip/?$ /ai-checklist/?utm_source=direct_invite&utm_medium=comp&utm_campaign=ic_workshop_0730&utm_content=track_comp [R=301,L,QSA]

# Clean URLs: append .html for any path without an extension. Handles top-level
# (/governance → /governance.html), nested (/lens/throughput → /lens/throughput.html,
# /for/hvac → /for/hvac.html, /signal/issue-3 → /signal/issue-3.html), and arbitrary
# depth. The character class [^\.]+ matches across "/" because slashes are not dots.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# =====================================================================
# RESTORE NOTE -- 2026-07-27 free-routing sweep (Boubacar, explicit)
# ---------------------------------------------------------------------
# The July 30 workshop is FREE through the event, so EVERY workshop short
# link was repointed to /ai-checklist/ (the free-seat capture). The paid
# pages themselves were deliberately NOT touched and still work:
# /workshop/, /workshop-b/ and /seat/ are all intact and reachable.
# This was a routing change only.
#
# To restore the paid routing after the workshop, swap ONLY the path in
# each rule below back to the destination listed here. Every utm_source,
# utm_medium, utm_campaign and utm_content value was preserved unchanged
# through the sweep, so nothing else needs editing.
#
#   w/svc    -> /workshop/     (was, pre 2026-07-27)
#   w/sjc    -> /workshop/
#   w/nl     -> /workshop/     (also had NO utm_content originally;
#                               utm_content=newsletter was ADDED 07-27)
#   w/sbdc   -> /workshop/     (also had NO utm_content originally;
#                               utm_content=sbdc_partner was ADDED 07-27)
#   w/beccy  -> /workshop/     (also had NO utm_content originally;
#                               utm_content=beccy was ADDED 07-27)
#   w/ss     -> /seat/         (paid: /seat/ renders a $47 CTA)
#   w/ads    -> /workshop-b/   (Meta split test, track DIRECT)
#   w/paid   -> /workshop/
#   w/vip    -> /rsvp-0730/    (do NOT blindly restore this one: the old
#                               target double-hopped and dropped the comp
#                               UTMs. It now goes straight to the final
#                               page in one hop. Restore only if comps
#                               need their own page again.)
#
# Already correct before the sweep, left alone, no restore needed:
#   w/li, w/x, w/free, w/fb, w/fb-organic, w/start, w/july16
#
# Constraint that outlives this sweep: /workshop/ and /workshop-b/
# attribute the paid split test with /track_free/.test(utm_content), so
# no slug's utm_content may contain the substring "track_free" unless it
# genuinely belongs to that paid arm.
# =====================================================================

# Force browsers to revalidate HTML + CSS on every load so style/layout fixes
# propagate immediately rather than living in client caches for hours.
# Static assets (images, fonts) keep long TTL via default LiteSpeed behavior.
<FilesMatch "\.(html|htm|css)$">
  Header set Cache-Control "no-cache, must-revalidate, max-age=0"
</FilesMatch>
